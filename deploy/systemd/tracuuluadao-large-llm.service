[Unit]
Description=TraCuuLuaDao large LLM service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=khoa2807
WorkingDirectory=/
EnvironmentFile=-/etc/default/tracuuluadao-models
Environment=LOCAL_MODELS_ROOT=/opt/local-models
Environment=LLAMA_SERVER_BIN=/opt/llama.cpp/build/bin/llama-server
Environment=TRACUULUADAO_LARGE_MODEL_PATH=/opt/local-models/models/qwopus3.6-35b-a3b-v1-gguf/Qwopus3.6-35B-A3B-v1-Q3_K_L.gguf
Environment=TRACUULUADAO_LARGE_MODEL_NAME=Qwopus3.6-35B-A3B-v1-Q3_K_L.gguf
Environment=TRACUULUADAO_LARGE_GPU_DEVICE=1
Environment=TRACUULUADAO_LARGE_PORT=8101
Environment=TRACUULUADAO_LARGE_CTX_SIZE=262144
Environment=TRACUULUADAO_LARGE_PARALLEL=1
ExecStart=/bin/bash -lc 'export GGUF_HOST_LLAMA_SERVER_BIN="${GGUF_HOST_LLAMA_SERVER_BIN:-${LLAMA_SERVER_BIN}}"; export GGUF_HOST_MODEL_PATH="${GGUF_HOST_MODEL_PATH:-${TRACUULUADAO_LARGE_MODEL_PATH}}"; export GGUF_HOST_MODEL_NAME="${GGUF_HOST_MODEL_NAME:-${TRACUULUADAO_LARGE_MODEL_NAME}}"; export GGUF_HOST_GPU_DEVICE="${GGUF_HOST_GPU_DEVICE:-${TRACUULUADAO_LARGE_GPU_DEVICE}}"; export GGUF_HOST_BIND="${GGUF_HOST_BIND:-0.0.0.0}"; export GGUF_HOST_PORT="${GGUF_HOST_PORT:-${TRACUULUADAO_LARGE_PORT}}"; export GGUF_HOST_CTX_SIZE="${GGUF_HOST_CTX_SIZE:-${TRACUULUADAO_LARGE_CTX_SIZE}}"; export GGUF_HOST_PARALLEL="${GGUF_HOST_PARALLEL:-${TRACUULUADAO_LARGE_PARALLEL}}"; export GGUF_HOST_CTX_CHECKPOINTS="${GGUF_HOST_CTX_CHECKPOINTS:-1}"; export GGUF_HOST_KV_UNIFIED="${GGUF_HOST_KV_UNIFIED:-1}"; export GGUF_HOST_FLASH_ATTN="${GGUF_HOST_FLASH_ATTN:-on}"; export GGUF_HOST_NO_MMPROJ_OFFLOAD="${GGUF_HOST_NO_MMPROJ_OFFLOAD:-1}"; export GGUF_HOST_NO_WARMUP="${GGUF_HOST_NO_WARMUP:-1}"; cd "${LOCAL_MODELS_ROOT}" && exec "${LOCAL_MODELS_ROOT}/scripts/qwopus36/run-qwopus36-35b-a3b-gguf.sh"'
Restart=always
RestartSec=5
KillMode=mixed
TimeoutStopSec=45

[Install]
WantedBy=multi-user.target
