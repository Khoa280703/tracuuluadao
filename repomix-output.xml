fn is_article_like_target(url: &str) -> bool {
    let Ok(parsed) = Url::parse(url) else {
        return false;
    };
    let path = parsed.path().to_ascii_lowercase();
    if path == "/" || path.is_empty() {
        return false;
    }

    [
        "/posts/",
        "/post/",
        "/threads/",
        "/thread/",
        "/groups/",
        "/warning/",
        "/report/",
        "/article/",
        "/articles/",
        "/news/",
    ]
    .iter()
    .any(|needle| path.contains(needle))
        || path
            .split('/')
            .filter(|segment| !segment.is_empty())
            .nth(1)
            .is_some()
}

