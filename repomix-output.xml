        "scraper",
        "json error",
        "http client",
        "cloudflare",
        "nginx",
        "javascript",
        "cookies",
        "dns-prefetch",
        "<link",
        "<script",
        "<meta",
        "<div",
        "<html",
        "nội dung scrape",
        "challenge",
        "captcha",
        "403 forbidden",
        "404 not found",
        "500 internal",
        "502 bad gateway",
        "503 service",
        "connection refused",
        "connection reset",
        "ssl",
        "tls",
        "certificate",
        "enablejs",
