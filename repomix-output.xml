    const status = ok.length === 3 ? 'OK' : `${ok.length}/3`;
    console.log(`  ${target.name}: avg=${formatMs(avg)} size=${Math.round(avgSize / 1024)}KB status=${status}`);
    if (results.some(r => !r.ok)) {
