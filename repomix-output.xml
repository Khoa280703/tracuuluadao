services:
  gateway:
    image: caddy:2.10-alpine
    restart: unless-stopped
    depends_on:
      - frontend
      - backend
    expose:
      - "8080"
    volumes:
      - ./deploy/coolify/Caddyfile:/etc/caddy/Caddyfile:ro

  frontend:
    build:
      context: ./frontend
      dockerfile: Dockerfile
    restart: unless-stopped
    expose:
      - "3000"
    environment:
      HOST: 0.0.0.0
      PORT: 3000

  backend:
    build:
      context: .
      dockerfile: Dockerfile.backend
    restart: unless-stopped
    depends_on:
      postgres:
        condition: service_healthy
      redis:
        condition: service_started
    expose:
      - "3067"
    extra_hosts:
      - "host.docker.internal:host-gateway"
    environment:
      APP_HOST: 0.0.0.0
      APP_PORT: 3067
      DATABASE_URL: postgres://postgres:${POSTGRES_PASSWORD:-postgres}@postgres:5432/tracuuluadao
      REDIS_URL: ${REDIS_URL:-redis://redis:6379/}
      INVESTIGATION_REPORT_TTL_SECS: ${INVESTIGATION_REPORT_TTL_SECS:-3600}
      PROXY_DIR: /app/proxies
      AGENT_CONFIG_DIR: /app/config/agents
      QWEN35_ENDPOINT: ${QWEN35_ENDPOINT:-http://host.docker.internal:8102/v1/chat/completions}
      QWEN36_ENDPOINT: ${QWEN36_ENDPOINT:-http://host.docker.internal:8002/v1/chat/completions}
      RUST_LOG: ${RUST_LOG:-info}

  postgres:
    image: postgres:16-alpine
    restart: unless-stopped
    expose:
      - "5432"
    environment:
      POSTGRES_DB: tracuuluadao
      POSTGRES_USER: postgres
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:-postgres}
    volumes:
      - postgres-data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U postgres -d tracuuluadao"]
      interval: 10s
      timeout: 5s
      retries: 10

  redis:
    image: redis:7-alpine
    restart: unless-stopped
    expose:
      - "6379"
    volumes:
      - redis-data:/data

volumes:
  postgres-data:
  redis-data:
</file>

