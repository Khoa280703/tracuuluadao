APP_HOST=0.0.0.0
APP_PORT=3067
# Optional: when omitted, app still boots but disables cache.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/tracuuluadao
# Optional: when omitted, final report replay falls back to direct SSE only.
REDIS_URL=redis://127.0.0.1:6379/
# Optional: simple admin auth for reviewing user reports.
ADMIN_API_KEY=
INVESTIGATION_REPORT_TTL_SECS=3600
PROXY_DIR=./proxies
AGENT_CONFIG_DIR=./config/agents
RUST_LOG=info
# Optional: thư mục log backend, hỗ trợ file xoay vòng theo ngày.
APP_LOG_DIR=./logs
APP_LOG_FILE_PREFIX=backend.log
# Optional: frontend build-time API base URL for web deployments without same-origin gateway.
# Leave empty to keep relative /api requests.
VITE_API_BASE_URL=
# Agent configs in this repo already target host-side model ports directly.
# Optional: hỗ trợ một số URL Facebook khó truy cập hơn.
FACEBOOK_COOKIE=c_user=...; xs=...
# Optional: bật thử nghiệm Google CLI sidecar.
GOOGLE_CLI_SIDECAR_ENABLED=0
GOOGLE_SCRAPER_PYTHON=python3
GOOGLE_SCRAPER_CLI_PATH=scripts/google_search_cli.py
# Optional: fallback browser thật để vượt enablejs khi HTTP scraper không đủ.
GOOGLE_BROWSER_SIDECAR_ENABLED=0
GOOGLE_BROWSER_SIDECAR_NODE=node
GOOGLE_BROWSER_SIDECAR_PATH=scripts/google-browser-sidecar/index.mjs
GOOGLE_BROWSER_SIDECAR_URL=
GOOGLE_BROWSER_SIDE_CAR_CHROME_PATH=/usr/bin/google-chrome
GOOGLE_BROWSER_SIDECAR_DISABLE_IMAGES=1
GOOGLE_BROWSER_SIDECAR_BLOCKED_RESOURCE_TYPES=image,media
GOOGLE_BROWSER_SIDECAR_FALLBACK_SETTLE_MS=700
GOOGLE_BROWSER_SIDECAR_SELECTOR_TIMEOUT_MS=2500
GOOGLE_BROWSER_SIDECAR_GOTO_TIMEOUT_MS=15000
GOOGLE_BROWSER_SIDECAR_PORT=4417
GOOGLE_BROWSER_SIDECAR_JOB_TIMEOUT_MS=45000
GOOGLE_BROWSER_SIDECAR_BROWSER_COUNT=5
GOOGLE_BROWSER_SIDECAR_SLOTS_PER_BROWSER=4
GOOGLE_BROWSER_SIDECAR_CHECKSCAM_BROWSER_COUNT=4
GOOGLE_BROWSER_SIDECAR_PROXY_REGISTRY_ENABLED=0
GOOGLE_BROWSER_SIDECAR_PROXY_COOLDOWN_MS=300000
GOOGLE_BROWSER_SIDECAR_PROXY_MAX_PER_FILE=0
GOOGLE_BROWSER_SIDECAR_PROXY_ATTEMPTS_PER_JOB=3
GOOGLE_BROWSER_SIDECAR_PROXY_DEFAULT_SOURCE_WEIGHT=100
GOOGLE_BROWSER_SIDECAR_PROXY_DISABLED_SOURCES=
GOOGLE_BROWSER_SIDECAR_PROXY_SOURCE_WEIGHTS=
GOOGLE_BROWSER_SIDECAR_FINGERPRINT_ROTATION_ENABLED=1
