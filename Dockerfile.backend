FROM rust:1.88-bookworm AS builder
WORKDIR /app

RUN apt-get update \
  && apt-get install -y --no-install-recommends cmake clang pkg-config make g++ perl \
  && rm -rf /var/lib/apt/lists/*

COPY Cargo.toml Cargo.lock ./
COPY src ./src
COPY config ./config

RUN cargo build --release

FROM debian:bookworm-slim AS runtime
WORKDIR /app

RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates tzdata \
  && rm -rf /var/lib/apt/lists/*

COPY --from=builder /app/target/release/tracuuluadao /usr/local/bin/tracuuluadao
COPY config ./config
RUN mkdir -p /app/proxies

ENV APP_HOST=0.0.0.0
ENV APP_PORT=3067
ENV AGENT_CONFIG_DIR=/app/config/agents
ENV PROXY_DIR=/app/proxies

EXPOSE 3067

CMD ["tracuuluadao"]
